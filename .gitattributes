# 归档产物必须逐字节可复现：ARCHIVE_MANIFEST.json 记录的是归档时文件的 SHA-256。
# 上游产物混用换行（qrels.test.json / review.jsonl 是 CRLF，sections.jsonl 是 LF），
# 因此这里禁止任何转换（-text = 按二进制原样存取），否则 checkout 后哈希对不上。
experiments/holdout-v1/** -text

# v2 manifest记录qrels字节哈希；Windows checkout也固定LF。
data/eval/qrels.json text eol=lf
data/eval/annotation_manifest.json text eol=lf
data/eval/evidence_review.jsonl text eol=lf

# 新版历史盲测重评的冻结清单使用字节哈希。
experiments/holdout-evidence-v2/** text eol=lf

# 本轮实验清单记录实际文件字节，保留Windows运行产物的原始换行。
experiments/rerank-2026-10-26-run1/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
scripts/run_rerank_experiment.py text eol=lf
scripts/check_rerank_experiment.py text eol=lf
