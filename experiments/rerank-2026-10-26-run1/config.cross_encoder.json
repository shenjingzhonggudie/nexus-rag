    "chunk_size": 300,
    "overlap": 50
  },
  "embedding": {
    "provider": "bge",
    "dim": 512,
    "model_name": "BAAI/bge-small-zh-v1.5"
  },
  "llm": {
    "provider": "none",
    "model": "",
    "api_key": "",
    "base_url": ""
  },
  "data_dir": "data\\raw",
  "index_dir": "data\\index"
